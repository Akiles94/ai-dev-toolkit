{
  "name": "@akiles94/ai-dev-toolkit",
  "version": "0.2.0",
  "description": "Use AI to write code without losing control of it: spec-driven workflow, small explained sections, stacked PRs.",
  "license": "MIT",
  "author": "Oscar Vinueza",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akiles94/ai-dev-toolkit.git"
  },
  "homepage": "https://github.com/Akiles94/ai-dev-toolkit#readme",
  "bugs": {
    "url": "https://github.com/Akiles94/ai-dev-toolkit/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "agents-md",
    "code-review",
    "spec-driven",
    "stacked-prs",
    "copilot",
    "claude-code",
    "github-copilot",
    "copilot-agents",
    "custom-agents",
    "claude-code-skills",
    "ai-code-review",
    "pull-request",
    "code-quality",
    "llm",
    "developer-tools",
    "cli"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "aidt": "dist/cli.js"
  },
  "files": [
    "dist",
    "products",
    "!products/**/*.test.ts",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "knip": "knip",
    "dup": "jscpd",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run knip && npm run dup && npm run test:coverage",
    "prepublishOnly": "npm run verify && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "jscpd": "^5.4.2",
    "knip": "^6.44.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
